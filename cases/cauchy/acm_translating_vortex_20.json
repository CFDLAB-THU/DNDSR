{
  "defaults": {
    "mesh": {
      "file": "data/mesh/IV10_20.cgns", "dimension": 2,
      "periodicLengths": [10, 10, 0],
      "boundaryIds": {"PERIODIC_1": -1, "PERIODIC_1_DONOR": -4, "PERIODIC_2": -2, "PERIODIC_2_DONOR": -5}
    },
    "equation": {
      "system": "incompressibleACM", "eos": "none", "transport": "inviscid",
      "acmAlpha": 0, "acmBeta2": 4,
      "referenceScales": {"rho0": 1, "U0": 1, "L0": 1, "T0": 300}
    },
    "initialState": {"type": "primUP", "state": [1, 1, 0, 0]},
    "initialField": {
      "integrationOrder": 6,
      "exprtkInitializers": [{
        "stateType": "primUP",
        "exprs": [
          "var k := 0.62831853071795865; var phaseX := k*(x[0]-t); var phaseY := k*(x[1]-t);",
          "UExprtk[0] := 1 + 0.2*sin(phaseX)*cos(phaseY); UExprtk[1] := 1 - 0.2*cos(phaseX)*sin(phaseY);",
          "UExprtk[2] := 0; UExprtk[3] := 0.01*(cos(2*phaseX)+cos(2*phaseY)); inRegion := 1; 0;"
        ]
      }]
    },
    "numerics": {
      "reconstruction": "variational", "flux": "rusanov", "limiter": "none",
      "positivity": false, "faceFallback": false, "viscousGradient": "polynomial",
      "reconstructionIterations": 320, "reconstructionTolerance": 1e-11,
      "cfv": {"maxOrder": 3, "intOrder": 6, "jacobiRelax": 0.8, "boundaryDerivativeWeights": [1, 0, 0, 0]}
    },
    "implicit": {
      "diagonal": "block", "jacobianAction": "assembled", "iterations": 300,
      "relativeTolerance": 1e-8, "absoluteTolerance": 1e-12,
      "residualComponents": ["u", "v", "p"], "rejectUnconvergedStages": true,
      "linear": {"method": "jacobi", "stopping": "fixedCount", "iterations": 8}
    }
  },
  "time": {"method": "bdf1", "dt": 0.1, "steps": 100, "tEnd": 10},
  "output": {"prefix": "data/outUnsteady/Cauchy/ACMVortex20/run", "checkpointInterval": 0, "visualizationInterval": 0}
}
