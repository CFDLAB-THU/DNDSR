{
  "defaults": {
    "mesh": {
      "file": "data/mesh/flatplate_273x193.cgns", "dimension": 2,
      "boundaryIds": {"WALL": 2, "INLET": 3, "SLIP": 4, "TOP": 5, "OUTLET": 6}
    },
    "equation": {
      "system": "incompressibleACM", "eos": "none", "transport": "Newtonian",
      "viscosity": 2e-7, "viscosityModel": "constantKinematic",
      "referenceScales": {"rho0": 1, "U0": 1, "L0": 1, "T0": 300},
      "acmAlpha": 0, "acmBeta2": 4,
      "rans": {"model": "SA", "viscosityReference": 2e-7}
    },
    "initialState": {"type": "primUP", "state": [1, 0, 0, 0, 3]},
    "referenceState": {"type": "primUP", "state": [1, 0, 0, 0, 3]},
    "boundaries": {
      "2": {"kind": "noSlipWall"},
      "3": {"kind": "velocityInlet", "state": {"type": "primUP", "state": [1, 0, 0, 0, 3]}},
      "4": {"kind": "slipWall"},
      "5": {"kind": "farfield", "state": {"type": "primUP", "state": [1, 0, 0, 0, 3]}},
      "6": {"kind": "pressureOutlet", "state": {"type": "primUP", "state": [1, 0, 0, 0, 3]}}
    },
    "numerics": {"reconstruction": "gradient", "gradient": "leastSquares",
                 "leastSquares": {"areaPower": 0, "distancePower": -3},
                 "viscousGradient": "polynomial", "flux": "Roe", "limiter": "none",
                 "positivity": false, "faceFallback": false},
    "implicit": {"diagonal": "block", "jacobianAction": "assembled",
                 "iterations": 10000, "pseudoCFL": 0.2, "maxPseudoCFL": 100, "pseudoGrowth": 1.005,
                 "relativeTolerance": 1e-7, "absoluteTolerance": 1e-11, "algebraicRateTolerance": 1e-8,
                 "rejectUnconvergedStages": true,
                 "linear": {"method": "gmres", "preconditioner": "ilu", "iterations": 5, "subspace": 5,
                            "stopping": "residual", "residualCheckInterval": 5,
                            "relativeTolerance": 0, "absoluteTolerance": 0},
                 "ilu": {"fill": 2}}
  },
  "time": {"steady": true, "method": "bdf1", "steps": 1},
  "output": {"prefix": "data/outUnsteady/Cauchy/ACMPlate_sa/run", "forceZones": [2],
             "checkpointInterval": 0, "visualizationInterval": 0,
             "boundaryFacialFluxes": true,
             "implicit": {"consoleInterval": 25, "historyInterval": 1, "visualizationInterval": 2500}}
}
