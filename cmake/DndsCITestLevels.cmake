# Keep the critical test and its build target in one declaration. Unlisted
# registrations remain available in Level 1, or Level 2 for large fixtures.
add_custom_target(ci_critical_tests)

function(dnds_ci_critical TARGET_NAME TEST_PATTERN)
    get_property(_tests DIRECTORY PROPERTY TESTS)
    list(FILTER _tests INCLUDE REGEX "^${TEST_PATTERN}$")
    foreach(_test IN LISTS _tests)
        set_property(TEST ${_test} APPEND PROPERTY LABELS level0)
    endforeach()
    if(_tests)
        add_dependencies(ci_critical_tests ${TARGET_NAME})
    elseif(TARGET ${TARGET_NAME})
        message(STATUS "Level 0: ${TARGET_NAME} has no registered test matching ^${TEST_PATTERN}$ (configured MPI sizes: ${DNDS_TEST_NP_LIST})")
    endif()
endfunction()

