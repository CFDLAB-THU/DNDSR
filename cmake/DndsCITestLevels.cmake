get_property(_tests DIRECTORY PROPERTY TESTS)
foreach(_test IN LISTS _tests)
    get_property(_labels TEST ${_test} PROPERTY LABELS)
    if(NOT "level0" IN_LIST _labels)
        if("integration" IN_LIST _labels)
            set_property(TEST ${_test} APPEND PROPERTY LABELS level2)
        else()
            set_property(TEST ${_test} APPEND PROPERTY LABELS level1)
        endif()
    endif()
endforeach()
