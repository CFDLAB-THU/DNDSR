get_property(_critical_mpi GLOBAL PROPERTY DNDS_CRITICAL_MPI_TESTS)
foreach(_entry IN LISTS _critical_mpi)
    string(REPLACE ":" ";" _fields "${_entry}")
    list(GET _fields 0 _test)
    list(GET _fields 1 _target)
    dnds_ci_critical(${_target} "${_test}")
endforeach()

# Hardware eligibility is independent of priority. CPU CI configures CUDA off.
